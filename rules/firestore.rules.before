rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // COURTS — Public read, auth+admin write
    match /courts/{courtId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // GAMES — Public read, authenticated users can create/update
    match /games/{gameId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // USERS — Each user can only read/write their own data
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // NOTIFICATIONS — User can read their own, server creates them
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // INTERESTED — Track who is interested in which court
    match /interested/{interestedId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // GAME_PLAYERS — Track who joined which game
    match /gamePlayers/{playerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ACTIVITY — Public live activity feed
    match /activity/{activityId} {
      allow read: if true;
      allow create: if request.auth != null;
    }
  }
}
